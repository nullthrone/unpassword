{
  "timeZone": "Europe/Berlin",
  "runtimeVersion": "V8",
  "exceptionLogging": "NONE",
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.message.readonly",
    "https://www.googleapis.com/auth/drive.file"
  ],
  "dependencies": {
    "enabledAdvancedServices": [{ "userSymbol": "Drive", "serviceId": "drive", "version": "v3" }]
  },
  "urlFetchWhitelist": [],
  "addOns": {
    "common": {
      "name": "unpassword",
      "logoUrl": "https://unpassword.nullthrone.xyz/brand/icon-128.png",
      "layoutProperties": { "primaryColor": "#141317", "secondaryColor": "#A87E2F" },
      "openLinkUrlPrefixes": ["https://unpassword.nullthrone.xyz/app/"]
    },
    "gmail": {
      "contextualTriggers": [{ "unconditional": {}, "onTriggerFunction": "onGmailMessageOpen" }]
    }
  }
}
